NODE_ENV=development
PORT=4000
# Empty disables proxy trust. Set only exact IPs of your controlled reverse proxies.
# The proxy must append/replace X-Forwarded-For with the actual remote client address.
TRUST_PROXY=
MONGODB_URI=mongodb://127.0.0.1:27017/ucf_lost_found?replicaSet=rs0
CLIENT_ORIGIN=https://localhost:5173
# Generate independent random values; never commit populated .env files.
JWT_SECRET=
# Stable 32-byte hex master key for MFA and encrypted mail; keep an offline backup.
# Changing this value requires data migration, not just an environment edit.
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
POST_RETENTION_DAYS=90
CLEANUP_INTERVAL_SECONDS=60
MAIL_TRANSPORT=file
MAIL_FROM=lostfound@ucf.edu
# Required for MAIL_TRANSPORT=smtp; production forbids the file mailbox.
# SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
