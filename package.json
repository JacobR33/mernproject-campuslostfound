{
  "name": "ucf-lost-found",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm test --workspace server && npm test --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "audit": "npm audit",
    "test:server": "npm test --workspace server",
    "test:client": "npm test --workspace client",
    "test:e2e": "npm run test:e2e --workspace client",
    "test:e2e:production": "npm run test:e2e:production --workspace client",
    "audit:production": "npm audit --omit=dev --audit-level=low"
  }
}
